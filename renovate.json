{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "commitMessagePrefix": "NO-ISSUE: ",
    "labels": [
        "lgtm",
        "approved"
    ],
    "baseBranches": [
        "backplane-2.10",
        "backplane-2.11",
        "backplane-2.17",
        "backplane-2.9",
        "backplane-5.0",
        "master"
    ],
    "prHourlyLimit": 0,
    "prConcurrentLimit": 0,
    "enabledManagers": [
        "custom.regex",
        "tekton"
    ],
    "tekton": {
        "managerFilePatterns": [
            "/^.tekton/*/"
        ]
    },
    "customManagers": [
        {
            "customType": "regex",
            "managerFilePatterns": [
                "/^Dockerfile\\./"
            ],
            "matchStrings": [
                "FROM registry.redhat.io/ubi9/ubi-minimal-pqc:(?<currentValue>[^@]+)@(?<currentDigest>sha256:[a-f0-9]+)\\n"
            ],
            "depNameTemplate": "registry.redhat.io/ubi9/ubi-minimal-pqc",
            "datasourceTemplate": "docker"
        }
    ],
    "packageRules": [
        {
            "groupName": "Konflux build pipeline",
            "addLabels": [
                "konflux"
            ],
            "schedule": [
                "on Saturday"
            ],
            "matchManagers": [
                "tekton"
            ],
            "baseBranchPatterns": [
                "backplane-2.10",
                "backplane-2.11",
                "backplane-2.17",
                "backplane-2.9",
                "backplane-5.0",
                "master"
            ]
        },
        {
            "matchPackageNames": [
                "registry.redhat.io/ubi9/ubi-minimal-pqc"
            ],
            "groupName": "UBI Runtime Images",
            "addLabels": [
                "ubi",
                "pqc"
            ],
            "baseBranchPatterns": [
                "backplane-2.10",
                "backplane-2.11",
                "backplane-2.17",
                "backplane-2.9",
                "backplane-5.0",
                "master"
            ]
        },
        {
            "matchUpdateTypes": [
                "major"
            ],
            "matchDatasources": [
                "docker"
            ],
            "matchPackageNames": [
                "registry.redhat.io/ubi9/ubi-minimal-pqc"
            ],
            "enabled": false
        }
    ]
}

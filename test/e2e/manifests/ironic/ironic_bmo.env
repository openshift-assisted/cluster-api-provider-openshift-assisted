# Pin the IPA ramdisk to a pre-1011624 revision; master breaks RHCOS first
# boot with parted-based config-drive partition placement.
# https://review.opendev.org/c/openstack/ironic-python-agent/+/1011624
IPA_BRANCH=stable/2026.2
HTTP_PORT=6180
PROVISIONING_INTERFACE=eth0
IRONIC_KERNEL_PARAMS=console=ttyS0
